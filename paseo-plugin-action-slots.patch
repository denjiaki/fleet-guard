+import React, { useCallback, useEffect, useMemo, useState } from "react";
+import {
+  Pressable,
+  Text,
+  type PressableStateCallbackType,
+  type StyleProp,
+  type ViewStyle,
+} from "react-native";
+import { StyleSheet, withUnistyles } from "react-native-unistyles";
+import type {
+  PluginComposerActionContribution,
+  PluginMessageActionContribution,
+} from "@paseo/plugin";
+import { LoadingSpinner } from "@/components/ui/loading-spinner";
+import { useToast } from "@/contexts/toast-context";
+import { useHostRuntimeClient } from "@/runtime/host-runtime";
+import type { AgentAttachment } from "@getpaseo/protocol/messages";
+import type { UserMessageImageAttachment } from "@/types/stream";
+import type { Theme } from "@/styles/theme";
+import { resolvePluginIcon } from "./icons";
+import { useInstalledPlugins } from "./registry";
+import type { InstalledPlugin } from "./types";
+
+type PluginActionContribution = PluginComposerActionContribution | PluginMessageActionContribution;
+
+const ThemedLoadingSpinner = withUnistyles(LoadingSpinner);
+const foregroundMutedMapping = (theme: Theme) => ({ color: theme.colors.foregroundMuted });
+// Module scope so these stay referentially stable — oxlint forbids inline
+// objects and functions as props on memoized (withUnistyles) components.
+const statusSuccessMapping = (theme: Theme) => ({ color: theme.colors.statusSuccess });
+const statusDangerMapping = (theme: Theme) => ({ color: theme.colors.statusDanger });
+
+function iconMapping(active: boolean | null) {
+  if (active === true) return statusSuccessMapping;
+  if (active === false) return statusDangerMapping;
+  return foregroundMutedMapping;
+}
+
+function PluginActionIcon({
+  Icon,
+  size,
+  color = "",
+}: {
+  Icon: ReturnType<typeof resolvePluginIcon>;
+  size: number;
+  color?: string;
+}) {
+  return <Icon size={size} color={color} />;
+}
+
+const ThemedPluginActionIcon = withUnistyles(PluginActionIcon);
+
+function outputMessage(output: unknown, fallback: string): string {
+  if (typeof output === "string" && output.trim()) return output.trim();
+  if (output && typeof output === "object") {
+    const message = Reflect.get(output, "message");
+    if (typeof message === "string" && message.trim()) return message.trim();
+  }
+  return fallback;
+}
+
+function actionButtonStyle(
+  compact: boolean,
+  active: boolean | null,
+): (state: PressableStateCallbackType & { hovered?: boolean }) => StyleProp<ViewStyle> {
+  return ({ hovered = false, pressed }) => [
+    compact ? styles.messageButton : styles.composerButton,
+    // `null` means the action declares no state contract, so it stays neutral.
+    active === true ? styles.buttonActive : null,
+    active === false ? styles.buttonInactive : null,
+    hovered ? styles.buttonHovered : null,
+    pressed ? styles.buttonPressed : null,
+  ];
+}
+
+function PluginActionButton({
+  plugin,
+  contribution,
+  payload,
+  compact,
+}: {
+  plugin: InstalledPlugin;
+  contribution: PluginActionContribution;
+  payload: Record<string, unknown>;
+  compact: boolean;
+}) {
+  const client = useHostRuntimeClient(plugin.serverId);
+  const toast = useToast();
+  const [pending, setPending] = useState(false);
+  const Icon = useMemo(() => resolvePluginIcon(contribution.icon), [contribution.icon]);
+
+  // Only composer actions may declare a state contract; message actions are
+  // one-shot and carry no on/off meaning.
+  const stateMethod = "state" in contribution ? contribution.state?.name : undefined;
+  const [active, setActive] = useState<boolean | null>(null);
+
+  const refreshState = useCallback(async () => {
+    if (!client || !stateMethod) return;
+    try {
+      const output = await client.invokePluginRpc(plugin.id, stateMethod, {});
+      const next =
+        output && typeof output === "object" ? Reflect.get(output, "active") : undefined;
+      // Anything that is not a clear boolean leaves the button neutral rather
+      // than asserting an on/off state the plugin did not actually report.
+      setActive(typeof next === "boolean" ? next : null);
+    } catch {
+      setActive(null);
+    }
+  }, [client, plugin.id, stateMethod]);
+
+  useEffect(() => {
+    void refreshState();
+  }, [refreshState]);
+
+  const onPress = useCallback(async () => {
+    if (!client || pending) return;
+    setPending(true);
+    try {
+      const output = await client.invokePluginRpc(plugin.id, contribution.action.name, payload);
+      toast.show(outputMessage(output, `${contribution.title} started.`), {
+        variant: "success",
+      });
+      // The press is what changes the state, so re-read it rather than guessing.
+      void refreshState();
+    } catch (error) {
+      toast.error(error instanceof Error ? error.message : String(error));
+    } finally {
+      setPending(false);
+    }
+  }, [
+    client,
+    contribution.action.name,
+    contribution.title,
+    payload,
+    pending,
+    plugin.id,
+    refreshState,
+    toast,
+  ]);
+  const accessibilityState = useMemo(
+    // `checked` is what a screen reader announces as on/off, and it is only
+    // meaningful for an action that actually reports state.
+    () => ({
+      busy: pending,
+      disabled: !client,
+      ...(active === null ? {} : { checked: active }),
+    }),
+    [active, client, pending],
+  );
+
+  return (
+    <Pressable
+      accessibilityRole={active === null ? "button" : "switch"}
+      accessibilityLabel={contribution.title}
+      accessibilityState={accessibilityState}
+      disabled={!client || pending}
+      onPress={onPress}
+      style={actionButtonStyle(compact, active)}
+      testID={`plugin-${compact ? "message" : "composer"}-action-${plugin.id}-${contribution.id}`}
+    >
+      {pending ? (
+        <ThemedLoadingSpinner size="small" uniProps={foregroundMutedMapping} />
+      ) : (
+        <ThemedPluginActionIcon
+          Icon={Icon}
+          size={compact ? 16 : 17}
+          uniProps={iconMapping(active)}
+        />
+      )}
+      {compact ? null : (
+        <Text
+          style={
+            active === false
+              ? [styles.composerButtonText, styles.composerButtonTextInactive]
+              : styles.composerButtonText
+          }
+        >
+          {contribution.title}
+        </Text>
+      )}
+    </Pressable>
+  );
+}
+
+export function PluginComposerActions({
+  serverId,
+  agentId,
+  workspaceId,
+}: {
+  serverId: string;
+  agentId: string;
+  workspaceId?: string | null;
+}) {
+  const plugins = useInstalledPlugins();
+  const actions = useMemo(
+    () =>
+      plugins
+        .filter((plugin) => plugin.serverId === serverId)
+        .flatMap((plugin) =>
+          plugin.composerActions.map((contribution) => ({ plugin, contribution })),
+        ),
+    [plugins, serverId],
+  );
+  const payload = useMemo(
+    () => ({ scope: "latest-context", agentId, workspaceId: workspaceId ?? null }),
+    [agentId, workspaceId],
+  );
+  return actions.map(({ plugin, contribution }) => (
+    <PluginActionButton
+      key={`${plugin.id}/${contribution.id}`}
+      plugin={plugin}
+      contribution={contribution}
+      payload={payload}
+      compact={false}
+    />
+  ));
+}
+
+export function PluginMessageActions({
+  serverId,
+  agentId,
+  messageId,
+  role,
+  text,
+  attachments = [],
+  images = [],
+}: {
+  serverId?: string;
+  agentId?: string;
+  messageId?: string;
+  role: "user" | "assistant";
+  text: string;
+  attachments?: AgentAttachment[];
+  images?: UserMessageImageAttachment[];
+}) {
+  const plugins = useInstalledPlugins();
+  const actions = useMemo(
+    () =>
+      !serverId || !agentId
+        ? []
+        : plugins
+            .filter((plugin) => plugin.serverId === serverId)
+            .flatMap((plugin) =>
+              plugin.messageActions.map((contribution) => ({ plugin, contribution })),
+            ),
+    [agentId, plugins, serverId],
+  );
+  const payload = useMemo(
+    () => ({
+      scope: "message",
+      agentId,
+      messageId: messageId ?? null,
+      role,
+      text,
+      attachments,
+      images,
+    }),
+    [agentId, attachments, images, messageId, role, text],
+  );
+  return actions.map(({ plugin, contribution }) => (
+    <PluginActionButton
+      key={`${plugin.id}/${contribution.id}`}
+      plugin={plugin}
+      contribution={contribution}
+      payload={payload}
+      compact
+    />
+  ));
+}
+
+const styles = StyleSheet.create((theme) => ({
+  composerButton: {
+    minHeight: 32,
+    flexDirection: "row",
+    alignItems: "center",
+    gap: theme.spacing[2],
+    paddingHorizontal: theme.spacing[3],
+    borderRadius: 999,
+    borderWidth: StyleSheet.hairlineWidth,
+    borderColor: theme.colors.border,
+    backgroundColor: theme.colors.background,
+  },
+  composerButtonText: {
+    color: theme.colors.foreground,
+    fontSize: theme.fontSize.sm,
+    fontWeight: "500",
+  },
+  messageButton: {
+    width: 28,
+    height: 28,
+    alignItems: "center",
+    justifyContent: "center",
+    borderRadius: 999,
+  },
+  composerButtonTextInactive: {
+    color: theme.colors.foregroundMuted,
+  },
+  // On/off tint for actions that declare a state contract. Border and a wash of
+  // background rather than a solid fill, so the pill still reads as a toolbar
+  // control next to its neutral neighbours.
+  buttonActive: {
+    borderColor: theme.colors.statusSuccess,
+  },
+  buttonInactive: {
+    borderColor: theme.colors.statusDanger,
+  },
+  buttonHovered: {
+    backgroundColor: theme.colors.surface2,
+  },
+  buttonPressed: {
+    opacity: 0.7,
+  },
+}));
