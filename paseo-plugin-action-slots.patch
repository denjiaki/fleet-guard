+  if (!supported.has(process.platform)) return null;
+  const platformDir = `${process.platform}-${process.arch}`;
+  const binarySegments = process.platform === "win32" ? ["esbuild.exe"] : ["bin", "esbuild"];
+  const candidate = path.join(
+    process.resourcesPath,
+    "app.asar.unpacked",
+    "node_modules",
+    "@esbuild",
+    platformDir,
+    ...binarySegments,
+  );
+  // Absent is not fatal: a build that bundles esbuild differently should fall
+  // through to esbuild's own resolution rather than be forced at a missing file.
+  return existsSync(candidate) ? candidate : null;
