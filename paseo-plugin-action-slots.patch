 ## Install a directory source
 
@@ -123,6 +124,47 @@ When the same plugin contribution exists on multiple hosts, Paseo shows it once
 adds a host picker to the screen header. The selected host supplies the bundle, RPC transport, and
 query cache. Plugin code cannot address another host.
 
+## Contribute composer and message actions
+
+Register declarative actions when a plugin needs a small, contextual command without owning a full
+screen. Paseo renders composer actions as labeled pills in the composer toolbar and message actions
+as icon buttons beside each completed message. Both invoke a plugin RPC on the active host.
+
+```tsx
+const review = defineRpc({
+  name: "review.run",
+  input: z.object({
+    scope: z.enum(["latest-context", "message"]),
+    agentId: z.string(),
+    messageId: z.string().nullable().optional(),
+    role: z.enum(["user", "assistant"]).optional(),
+    text: z.string().optional(),
+  }),
+  output: z.object({ message: z.string() }),
+});
+
+export default function contribute(plugin: PluginContext) {
+  plugin.handle(review, runReview);
+  plugin.addComposerAction({
+    id: "skeptic-review",
+    title: "Skeptic Review",
+    icon: "Brain",
+    action: review,
+  });
+  plugin.addMessageAction({
+    id: "review-message",
+    title: "Review with council",
+    icon: "Brain",
+    action: review,
+  });
+  return () => undefined;
+}
+```
+
+The composer payload includes `scope`, `agentId`, and `workspaceId`. The message payload also
+includes the message ID, role, text, and serializable attachment and image metadata. Paseo owns the
+button presentation, pending state, RPC validation, and success or error toast.
+
 ## Contribute composer attachments
 
